rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Máximo de membros: as primeiras contas cadastradas viram membros e o acesso fecha.
    function maxMembers() { return 2; }

    function verified() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function isMember() {
      return verified() && exists(/databases/$(database)/documents/members/$(request.auth.uid));
    }
    // Garante que o autor gravado é sempre quem está logado
    function stampedByMe() {
      return request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorEmail == request.auth.token.email;
    }

    // Contador de vagas
    match /config/members {
      allow read: if verified();
      allow create: if verified()
        && request.resource.data.count == 1
        && existsAfter(/databases/$(database)/documents/members/$(request.auth.uid));
      allow update: if verified()
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.count <= maxMembers()
        && !exists(/databases/$(database)/documents/members/$(request.auth.uid))
        && existsAfter(/databases/$(database)/documents/members/$(request.auth.uid));
    }

    match /members/{uid} {
      allow read: if verified() && (uid == request.auth.uid || isMember());
      allow create: if verified() && uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && getAfter(/databases/$(database)/documents/config/members).data.count <= maxMembers()
        && (exists(/databases/$(database)/documents/config/members)
              ? getAfter(/databases/$(database)/documents/config/members).data.count
                == get(/databases/$(database)/documents/config/members).data.count + 1
              : getAfter(/databases/$(database)/documents/config/members).data.count == 1);
      allow update, delete: if false;
    }

    match /messages/{id} {
      allow read: if isMember();
      allow create: if isMember() && stampedByMe();
      allow update, delete: if false;
    }

    match /files/{fileId} {
      allow read: if isMember();
      allow create, update: if isMember()
        && request.resource.data.lastEditorUid == request.auth.uid;
      allow delete: if isMember();

      match /revisions/{revId} {
        allow read: if isMember();
        allow create: if isMember() && stampedByMe();
        allow update, delete: if false;
      }
    }
  }
}
