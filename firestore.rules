rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // >>> EDITE: e-mails autorizados a usar o ambiente <<<
    function isMember() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'voce@exemplo.com',
          'amigo@exemplo.com'
        ];
    }

    // Garante que o autor gravado é sempre quem está logado
    function stampedByMe() {
      return request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorEmail == request.auth.token.email;
    }

    match /messages/{id} {
      allow read: if isMember();
      allow create: if isMember() && stampedByMe();
      allow update, delete: if false; // histórico de chat imutável
    }

    match /files/{fileId} {
      allow read: if isMember();
      allow create, update: if isMember()
        && request.resource.data.lastEditorUid == request.auth.uid;
      allow delete: if isMember();

      // Cada alteração vira uma revisão imutável com autor
      match /revisions/{revId} {
        allow read: if isMember();
        allow create: if isMember() && stampedByMe();
        allow update, delete: if false;
      }
    }
  }
}
